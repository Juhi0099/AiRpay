# Public frontend configuration. Never put deployment secrets in VITE_* variables.
VITE_MONAD_CHAIN_ID=10143
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VITE_VAULT_ADDRESS=

# Local deployment secrets (not committed or exposed in the frontend)
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_PRIVATE_KEY=

# Legacy demo-only variable left for compatibility; use a server-side relayer in production.
VITE_RELAYER_PRIVATE_KEY=
